{
  "openapi": "3.1.0",
  "info": {
    "title": "Document Search API",
    "description": "API for searching documents using Elasticsearch.",
    "version": "0.1.0"
  },
  "paths": {
    "/search": {
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "Search documents",
        "description": "Search documents by text. Returns up to 20 documents sorted by creation date.",
        "operationId": "search_search_get",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Text to search for.",
              "examples": [
                "example"
              ],
              "title": "Query"
            },
            "description": "Text to search for."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DocumentSchema"
                  },
                  "title": "Response Search Search Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/documents/{document_id}": {
      "delete": {
        "tags": [
          "Documents"
        ],
        "summary": "Delete document",
        "description": "Delete a document from the database and Elasticsearch by id(int32).",
        "operationId": "deletion_documents__document_id__delete",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "maximum": 2147483647,
              "exclusiveMinimum": 0,
              "description": "Document id(int32).",
              "examples": [
                1
              ],
              "title": "Document Id"
            },
            "description": "Document id(int32)."
          }
        ],
        "responses": {
          "204": {
            "description": "Document deleted successfully"
          },
          "404": {
            "description": "Document not found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DocumentSchema": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "rubrics": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Rubrics"
          },
          "created_date": {
            "type": "string",
            "format": "date-time",
            "title": "Created Date"
          }
        },
        "type": "object",
        "required": [
          "id",
          "text",
          "rubrics",
          "created_date"
        ],
        "title": "DocumentSchema"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "tags": [
    {
      "name": "Documents",
      "description": "Search and delete documents."
    }
  ]
}